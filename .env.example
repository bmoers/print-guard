# =============================================================================
# SLACK CONFIGURATION
# Required: Bot token and channel for sending notifications
# =============================================================================

# Slack Bot OAuth token (starts with xoxb-)
# Get this from: https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack channel ID to post notifications (starts with C)
# Right-click channel → View channel details → scroll to bottom for ID
SLACK_CHANNEL_ID=C0123456789

# =============================================================================
# PRINTER CONNECTION
# WebSocket URL for connecting to Creality Ender V3 printer
# =============================================================================

# Printer WebSocket endpoint for real-time status updates
PRINTER_WS_URL=ws://192.168.1.66:9999/

# How often to retry connection when printer is offline (milliseconds)
# Default: 300000 (5 minutes)
OFFLINE_POLL_INTERVAL=300000

# =============================================================================
# CAMERA
# Optional: Configure camera for the web dashboard and Slack notifications
# Stream URL is preferred for the dashboard (smooth MJPEG video)
# Snapshot URL is used for Slack image attachments and as dashboard fallback
# =============================================================================

# MJPEG stream URL for the web dashboard (smooth live video)
# Used by the dashboard camera feed — browser handles the stream natively
# Leave empty to fall back to snapshot polling
PRINTER_STREAM_URL=http://192.168.1.66:8080/?action=stream

# Camera snapshot URL for Slack notifications (single JPEG capture)
# Also used as dashboard fallback when PRINTER_STREAM_URL is not set
PRINTER_SNAPSHOT_URL=http://192.168.1.66:8080/?action=snapshot

# Delay before capturing snapshot after event triggers (milliseconds)
# Allows time for camera to stabilize or printer to reach position
# Default: 3000 (3 seconds)
SNAPSHOT_DELAY_MS=3000

# =============================================================================
# NOTIFICATION TOGGLES
# Set to true/false to enable/disable specific Slack notifications
# All default to true if not specified
# =============================================================================

# Send "Print Monitor started" when the application launches
NOTIFY_STARTUP=true

# Send "Printer online" when WebSocket connection to printer is established
NOTIFY_PRINTER_ONLINE=true

# Send "Print job submitted" when print job is received (printer heating)
NOTIFY_JOB_SUBMITTED=true

# Send "Print started" with filename when a new print job begins (progress > 0%)
NOTIFY_PRINT_STARTED=true

# Send "Print Complete!" with filename, duration, and material used when job finishes
NOTIFY_JOB_COMPLETE=true

# Send "Print Cancelled" when a print job is stopped before completion
NOTIFY_JOB_CANCELLED=true

# =============================================================================
# IMAGE TOGGLES
# Set to true/false to include camera snapshots in notifications
# Requires PRINTER_SNAPSHOT_URL to be configured above
# All default to true if not specified
# =============================================================================

# Capture and attach camera image when print starts
IMAGE_ON_PRINT_STARTED=true

# Capture and attach camera image when print completes
IMAGE_ON_JOB_COMPLETE=true

# Capture and attach camera image when print is cancelled
IMAGE_ON_JOB_CANCELLED=true

# =============================================================================
# WEB DASHBOARD
# Optional: Browser-based printer status UI with live camera feed
# =============================================================================

# Enable/disable the web dashboard
# Default: true
WEB_ENABLED=true

# Port for the web dashboard
# Default: 3000
WEB_PORT=3000
